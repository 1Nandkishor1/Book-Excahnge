# Copy to .env and edit. Defaults in src/config.js work for local dev.
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/book_exchange
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=24h
# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
